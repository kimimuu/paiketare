            { "name": "approval", "runtime": "Nodejs18.15", "memorySize": 64, "timeout": 60 },
            { "name": "messages", "runtime": "Nodejs18.15", "memorySize": 64, "timeout": 60 }
          ],
          "functionRootPath": "cloudfunctions"
        }
      }
    }
